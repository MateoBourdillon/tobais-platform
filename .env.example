# Database Configuration
DATABASE_URL=postgres://usuario:contraseña@host:puerto/nombre_db
PGUSER=usuario_db
PGPASSWORD=contraseña_db
PGHOST=host_db
PGDATABASE=nombre_db
PGPORT=5432

# API Keys
OPENAI_API_KEY=tu_clave_api_openai

# Stripe Keys
STRIPE_SECRET_KEY=sk_test_xxxxxx
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxx
STRIPE_PRICE_ID=price_xxxxxx

# Authentication
SESSION_SECRET=string_aleatorio_para_sesiones

# Email Service Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_contraseña_o_token_app

# SendGrid Configuration (for auth emails only)
