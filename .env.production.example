# Copia este archivo como `.env.production` y rellena los valores antes de
# ejecutar `npm run build` para generar el frontend que se sube a Hostinger.
#
# Solo claves PÚBLICAS: todo lo que esté aquí acaba dentro del JavaScript que
# descarga el navegador. Las claves secretas (STRIPE_SECRET_KEY, DATABASE_URL,
# OPENAI_API_KEY, etc.) van únicamente en las variables de entorno de Render.

# URL del backend desplegado en Render, sin barra final.
VITE_API_URL=https://tobais-api.onrender.com

# Clave publicable de Stripe (empieza por pk_live_ o pk_test_).
VITE_STRIPE_PUBLIC_KEY=

# Client ID de PayPal (es público).
VITE_PAYPAL_CLIENT_ID=
